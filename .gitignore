# System and editor temporary files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Caches and virtual environments
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.local-evidence/
.venv/
venv/
env/

# Temporary files
*.tmp
*.temp
*.bak
*.bak-*

# Copyrighted article/full-text PDFs in working directories
**/fulltext/**/*.pdf
**/papers/**/*.pdf
**/articles/**/*.pdf
**/literature/**/*.pdf
search/material/pdfs/
# Pacotes dos PDFs: a regra acima cobre a PASTA, nao um .zip ao lado dela.
# 1,2 GB de texto completo sob licenca de editora entrariam num `git add -A`.
search/material/*.zip

# Dated snapshots of the master CSV; git itself is the version history
search/material/backups/

# LaTeX build intermediates of the protocol rendering; the .tex is the source
protocol/*/build/*
!protocol/*/build/protocol_standalone.tex

# Credentials and secrets
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.json
*token*
